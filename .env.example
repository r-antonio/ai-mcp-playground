# GitHub Configuration
# Your GitHub Personal Access Token with 'admin:org' scope
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# Your GitHub organization name
GITHUB_ORG=your-org-name

# Jira Configuration
# Your Jira API token (generate from https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_TOKEN=your_jira_api_token
# Your Jira instance URL (e.g., https://your-domain.atlassian.net)
JIRA_BASE_URL=https://your-domain.atlassian.net